PORT=3000
CLIENT_ORIGIN=http://localhost:5500
GAIA_SPREADSHEET_PATH=
GAIA_ADMIN_TOKEN=
GAIA_AVISOS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# ── Banco SQLite de horários ────────────────────────────────────────
# Opcional. Vazio = server/src/database/gaia.db.
# O arquivo não é versionado: gere com `npm run db:import` dentro de server/.
GAIA_DATABASE_PATH=

# ── Supabase Auth ───────────────────────────────────────────────────
# Supabase Studio → Settings → API.
# Com estes dois vazios, o servidor responde 503 em /api/auth/eu e o app
# continua usando o login local do localStorage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# A service_role key ignora o RLS. Só use no servidor, nunca no cliente,
# e apenas se precisar de operações administrativas (ex.: promover a admin).
SUPABASE_SERVICE_ROLE_KEY=
